{
  "name": "password-vault-browser",
  "version": "0.1.0",
  "description": "Privacy-focused multi-session browser with isolated tabs and global credential management",
  "main": "dist/main/index.js",
  "type": "commonjs",
  "scripts": {
    "build": "npm run build:main && npm run build:preload && npm run build:renderer && npm run copy-assets",
    "build:main": "tsc -p tsconfig.main.json",
    "build:preload": "tsc -p tsconfig.preload.json",
    "build:renderer": "node scripts/build-renderer.js",
    "typecheck:renderer": "tsc -p tsconfig.renderer.json --noEmit",
    "copy-assets": "node -e \"const fs=require('fs'),p=require('path');fs.mkdirSync(p.join('dist','renderer','styles'),{recursive:true});fs.copyFileSync(p.join('src','renderer','index.html'),p.join('dist','renderer','index.html'));fs.copyFileSync(p.join('src','renderer','styles','global.css'),p.join('dist','renderer','styles','global.css'));\"",
    "start": "electron .",
    "dev": "npm run build && electron .",
    "clean": "rm -rf dist/",
    "pack": "npm run build && npx electron-builder --dir",
    "dist": "npm run build && npx electron-builder",
    "dist:portable": "npm run build && npx electron-builder --win portable"
  },
  "build": {
    "appId": "com.passwordvault.browser",
    "productName": "Password Vault Browser",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": null
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerSidebar": null,
      "createDesktopShortcut": true,
      "runAfterFinish": true
    },
    "extraMetadata": {
      "main": "dist/main/index.js"
    }
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/uuid": "^10.0.0",
    "electron": "^33.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "tsx": "^4.23.1",
    "typescript": "^5.7.0"
  }
}