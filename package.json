{
  "name": "password-vault-browser",
  "version": "0.1.0",
  "description": "Privacy-focused multi-session browser with isolated tabs and global credential management",
  "main": "dist/main/index.js",
  "type": "commonjs",
  "scripts": {
    "build": "npm run build:main && npm run build:preload && npm run build:renderer && npm run copy-assets",
    "build:main": "tsc -p tsconfig.main.json",
    "build:preload": "tsc -p tsconfig.preload.json",
    "build:renderer": "tsc -p tsconfig.renderer.json",
    "copy-assets": "cp -r src/renderer/index.html dist/renderer/ && mkdir -p dist/renderer/styles && cp -r src/renderer/styles/global.css dist/renderer/styles/",
    "start": "electron .",
    "dev": "npm run build && electron .",
    "clean": "rm -rf dist/",
    "pack": "npm run build && npx electron-builder --dir",
    "dist": "npm run build && npx electron-builder",
    "dist:portable": "npm run build && npx electron-builder --win portable"
  },
  "build": {
    "appId": "com.passwordvault.browser",
    "productName": "Password Vault Browser",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": null
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerSidebar": null,
      "createDesktopShortcut": true,
      "runAfterFinish": true
    },
    "extraMetadata": {
      "main": "dist/main/index.js"
    }
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/uuid": "^10.0.0",
    "copyfiles": "^2.4.1",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "tsx": "^4.23.1",
    "typescript": "^5.7.0"
  }
}
